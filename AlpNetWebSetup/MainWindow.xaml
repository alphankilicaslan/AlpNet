<Window x:Class="AlpNetWebSetup.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AlpNet Launcher" Height="300" Width="400"
        WindowStyle="None" Background="#13151A" ResizeMode="NoResize" WindowStartupLocation="CenterScreen" AllowsTransparency="True">
    
    <Window.Resources>
        <Style x:Key="FlatButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#00FF87"/>
            <Setter Property="Foreground" Value="#13151A"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#00E076"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border BorderBrush="#252833" BorderThickness="1" CornerRadius="15">
        <Grid>
            <!-- Title Bar -->
            <Grid Height="40" VerticalAlignment="Top" Background="Transparent" MouseDown="TitleBar_MouseDown">
                <TextBlock Text="AlpNet Launcher" Foreground="#ADB5BD" FontWeight="Bold" VerticalAlignment="Center" Margin="15,0,0,0"/>
                <Button Content="✕" Width="40" HorizontalAlignment="Right" Background="Transparent" Foreground="#ADB5BD" BorderThickness="0" Click="CloseButton_Click" Cursor="Hand" FontSize="16" FontWeight="Bold"/>
            </Grid>

            <!-- Main Content -->
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="20,40,20,20">
                <TextBlock Text="ALPNET" FontSize="36" FontWeight="ExtraBold" Foreground="#F8F9FA" HorizontalAlignment="Center"/>
                <TextBlock Text="Pulse Cloud Setup" FontSize="13" Foreground="#00F2FE" HorizontalAlignment="Center" Margin="0,0,0,30"/>

                <Button x:Name="BtnLaunch" Content="İNDİR VE BAŞLAT" Height="50" Width="250" Style="{StaticResource FlatButtonStyle}" Click="BtnLaunch_Click"/>

                <StackPanel x:Name="PanelProgress" Visibility="Collapsed" Margin="0,15,0,0">
                    <TextBlock x:Name="TxtStatus" Text="Bağlanıyor..." Foreground="#ADB5BD" HorizontalAlignment="Center" Margin="0,0,0,5"/>
                    <ProgressBar x:Name="PbDownload" Height="6" Width="250" Background="#1A1C23" Foreground="#00FF87" BorderThickness="0" Minimum="0" Maximum="100"/>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
</Window>
