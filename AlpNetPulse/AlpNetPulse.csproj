<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>alpnet_icon.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Company>AlpNet</Company>
    <Product>AlpNet Pulse</Product>
    <Description>AlpNet Pulse Network Utility</Description>
    <Copyright>Copyright © 2026 AlpNet</Copyright>
    <AssemblyVersion>2.2.7.0</AssemblyVersion>
    <FileVersion>2.2.7.0</FileVersion>
    <Version>2.2.7</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.6" />
    <PackageReference Include="NAudio" Version="2.3.0" />
    <PackageReference Include="Obfuscar" Version="2.2.40">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="System.Management" Version="10.0.8" />
    <PackageReference Include="System.Speech" Version="10.0.8" />
  </ItemGroup>
  
  <ItemGroup>
    <Content Include="..\translator.exe">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>translator.exe</Link>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </Content>
  </ItemGroup>
  
  <ItemGroup>
    <Resource Include="alpnet_icon.ico" />
    <EmbeddedResource Include="Resources\VBCable.zip" />
    <EmbeddedResource Include="Resources\wiresock.msi" />
    <EmbeddedResource Include="Resources\wpf_driver.msi" />
    <EmbeddedResource Include="Resources\wgcf.exe" />
  </ItemGroup>

</Project>
