<Window x:Class="AlpNetPulse.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="AlpNet Pulse" Height="800" Width="1200"
        WindowStartupLocation="CenterScreen"
        Icon="alpnet_icon.ico"
        Background="#0B0C10"
        Foreground="#F8F9FA"
        FontFamily="Segoe UI, Inter"
        WindowStyle="None"
        ResizeMode="CanResize">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" 
                      ResizeBorderThickness="6" 
                      GlassFrameThickness="1" 
                      CornerRadius="16"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>

        <!-- Dark theme ScrollBar thumb style -->
        <Style x:Key="DarkScrollBarThumb" TargetType="Thumb">
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border CornerRadius="5" Background="#4A5080" Margin="3,3,3,3"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Thumb">
                                <Border CornerRadius="5" Background="#4A90D9" Margin="3,3,3,3"/>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
                <Trigger Property="IsDragging" Value="True">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Thumb">
                                <Border CornerRadius="5" Background="#00F2FE" Margin="3,3,3,3"/>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Dark theme ScrollBar style -->
        <Style x:Key="DarkScrollBar" TargetType="ScrollBar">
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Width" Value="24"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Margin="4,6,4,6">
                            <Border Background="#1A1D28" CornerRadius="6"/>
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.LineUpCommand" Opacity="0"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource DarkScrollBarThumb}"/>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.LineDownCommand" Opacity="0"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dark ScrollViewer -->
        <Style x:Key="FavScrollViewer" TargetType="ScrollViewer">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollViewer">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ScrollContentPresenter Grid.Column="0"/>
                            <ScrollBar x:Name="PART_VerticalScrollBar"
                                       Grid.Column="1"
                                       Style="{StaticResource DarkScrollBar}"
                                       Value="{TemplateBinding VerticalOffset}"
                                       Maximum="{TemplateBinding ScrollableHeight}"
                                       ViewportSize="{TemplateBinding ViewportHeight}"
                                       Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Global ScrollBar override for all ScrollBars in the app -->
        <Style TargetType="ScrollBar" BasedOn="{StaticResource DarkScrollBar}"/>

        <Style x:Key="FlatButtonStyle" TargetType="Button">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI"/>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="#15171E"/>
            <Setter Property="Foreground" Value="#F8F9FA"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style x:Key="DarkComboBox" TargetType="ComboBox">
            <Setter Property="Background" Value="#15171E"/>
            <Setter Property="Foreground" Value="#F8F9FA"/>
            <Setter Property="BorderBrush" Value="#252833"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton" Grid.Column="2" Focusable="false" IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" ClickMode="Press">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="#15171E" BorderBrush="#252833" BorderThickness="1" CornerRadius="4">
                                            <TextBlock Text="▼" Foreground="#ADB5BD" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter x:Name="ContentSite" IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" Margin="10,5" VerticalAlignment="Center" HorizontalAlignment="Left" />
                            <Popup x:Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                                <Grid x:Name="DropDown" SnapsToDevicePixels="True" MinWidth="{TemplateBinding ActualWidth}" MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border x:Name="DropDownBorder" Background="#15171E" BorderThickness="1" BorderBrush="#252833"/>
                                    <ScrollViewer Margin="1" SnapsToDevicePixels="True">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Grid>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border BorderBrush="#1F222B" BorderThickness="1.5" CornerRadius="16" Background="#0B0C10" ClipToBounds="True">
        <Grid>
            <!-- Title Bar -->
            <Grid VerticalAlignment="Top" Height="40" Background="#11131A">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <!-- Title & logo -->
                <StackPanel Orientation="Horizontal" Margin="15,0,0,0" Background="Transparent">
                    <TextBlock Text="⚡" VerticalAlignment="Center" Foreground="#00F2FE" FontWeight="Bold" FontSize="16" Margin="0,0,8,0"/>
                    <TextBlock Text="AlpNet Pulse" VerticalAlignment="Center" FontWeight="Bold" Foreground="#F8F9FA" FontSize="14"/>
                    <Border CornerRadius="4" Background="#1D2A35" Margin="10,0,0,0" Height="20" VerticalAlignment="Center">
                        <TextBlock Text="Pro" FontSize="10" FontWeight="Bold" Foreground="#00F2FE" Margin="6,2,6,2"/>
                    </Border>
                </StackPanel>
                
                <!-- Titlebar window action buttons -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,10,0" VerticalAlignment="Center" WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Content="&#xE921;" FontFamily="Segoe MDL2 Assets" Width="30" Height="24" Background="Transparent" Foreground="#F8F9FA" BorderBrush="Transparent" Click="MinimizeButton_Click" FontSize="10" FontWeight="Bold" Cursor="Hand"/>
                    <Button x:Name="BtnMaximize" Content="&#xE922;" FontFamily="Segoe MDL2 Assets" Width="30" Height="24" Background="Transparent" Foreground="#F8F9FA" BorderBrush="Transparent" Click="MaximizeButton_Click" FontSize="10" FontWeight="Bold" Cursor="Hand"/>
                    <Button Content="&#xE8BB;" FontFamily="Segoe MDL2 Assets" Width="30" Height="24" Background="Transparent" Foreground="#F8F9FA" BorderBrush="Transparent" Click="CloseButton_Click" FontSize="10" FontWeight="Bold" Cursor="Hand"/>
                </StackPanel>
            </Grid>

            <!-- Main Container -->
            <Grid Margin="0,40,0,0">
                <!-- LOADING OVERLAY (PREVENTS FLASHING OF ACTIVATION PAGE) -->
                <Grid x:Name="LoadingOverlay" Panel.ZIndex="150" Background="#F50B0C10" Visibility="Visible">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" TextBlock.TextAlignment="Center">
                        <TextBlock Text="⚡" FontSize="48" Margin="0,0,0,15" Foreground="#00F2FE">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <EventTrigger RoutedEvent="Loaded">
                                            <BeginStoryboard>
                                                <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.3" To="1" Duration="0:0:0.8"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="AlpNet Pulse Başlatılıyor..." FontSize="16" FontWeight="ExtraBold" Foreground="#F8F9FA"/>
                        <TextBlock Text="Lütfen bekleyin..." FontSize="11" Foreground="#ADB5BD" Margin="0,5,0,0"/>
                    </StackPanel>
                </Grid>

                <!-- MAINTENANCE OVERLAY -->
                <Grid x:Name="MaintenanceOverlay" Panel.ZIndex="200" Background="#F00B0C10" Visibility="Collapsed">
                    <Border BorderBrush="#252833" BorderThickness="1" Background="#1E2028" CornerRadius="20" Width="400" Height="300" VerticalAlignment="Center" HorizontalAlignment="Center" WindowChrome.IsHitTestVisibleInChrome="True">
                        <Border.Effect>
                            <DropShadowEffect Color="#FF3B30" BlurRadius="40" Opacity="0.2" ShadowDepth="0"/>
                        </Border.Effect>
                        <StackPanel Margin="30" VerticalAlignment="Center">
                            <TextBlock Text="🔧" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,15"/>
                            <TextBlock Text="SİSTEM BAKIMDA" FontSize="20" FontWeight="ExtraBold" HorizontalAlignment="Center" Foreground="#FF3B30" Margin="0,0,0,10"/>
                            <TextBlock x:Name="TxtMaintenanceMsg" Text="Sunucularımızda bakım çalışması yapılıyor. Lütfen daha sonra tekrar deneyin." FontSize="14" Foreground="#F8F9FA" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- IN-APP MESSAGE BANNER -->
                <Grid x:Name="InAppMessageOverlay" Panel.ZIndex="300" Visibility="Collapsed" VerticalAlignment="Top" Margin="20,10,20,0">
                    <Border Background="#15171E" BorderBrush="#00F2FE" BorderThickness="1,1,1,2" CornerRadius="8" Padding="15,10">
                        <Border.Effect>
                            <DropShadowEffect Color="#00F2FE" BlurRadius="20" Opacity="0.3" ShadowDepth="0"/>
                        </Border.Effect>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="📢" FontSize="20" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock x:Name="TxtInAppMessage" Grid.Column="1" Text="Mesaj buraya gelecek" FontSize="13" Foreground="#F8F9FA" VerticalAlignment="Center" TextWrapping="Wrap"/>
                            <Button Grid.Column="2" Content="&#xE8BB;" FontFamily="Segoe MDL2 Assets" Width="25" Height="25" Background="Transparent" Foreground="#ADB5BD" BorderBrush="Transparent" FontSize="10" FontWeight="Bold" Cursor="Hand" Click="CloseMessageBanner_Click" VerticalAlignment="Center" Margin="10,0,0,0"/>
                        </Grid>
                    </Border>
                </Grid>


                <!-- LICENSE OVERLAY -->
                <Grid x:Name="LicenseOverlay" Panel.ZIndex="100" Background="#F00B0C10" Visibility="Collapsed">
                    <Border BorderBrush="#1C2F3D" BorderThickness="1" Background="#1E2028" CornerRadius="20" Width="420" Height="530" VerticalAlignment="Center" HorizontalAlignment="Center" WindowChrome.IsHitTestVisibleInChrome="True">
                        <Border.Effect>
                            <DropShadowEffect Color="#00F2FE" BlurRadius="30" Opacity="0.15" ShadowDepth="0"/>
                        </Border.Effect>
                        <StackPanel Margin="30,25,30,25">
                            <TextBlock Text="🔌" FontSize="36" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                            <TextBlock Text="AlpNet Pulse Aktivasyon" FontSize="20" FontWeight="ExtraBold" HorizontalAlignment="Center" Foreground="#F8F9FA"/>
                            <TextBlock Text="Uygulamayı kullanabilmek için geçerli bir lisans girin." FontSize="11" Foreground="#ADB5BD" HorizontalAlignment="Center" Margin="0,5,0,20" TextAlignment="Center"/>


                            <!-- Device ID field -->
                            <TextBlock Text="CİHAZ KİMLİĞİ (HARDWARE ID)" FontSize="10" FontWeight="Bold" Foreground="#ADB5BD" Margin="0,0,0,5"/>
                            <Grid Margin="0,0,0,15">
                                <TextBox x:Name="TxtDeviceId" Text="Yükleniyor..." IsReadOnly="True" Background="#15171E" Foreground="#00F2FE" BorderBrush="#252833" Padding="8" FontSize="11" FontFamily="Consolas" TextAlignment="Center" Cursor="Hand" PreviewMouseDown="CopyDeviceId_Click"/>
                            </Grid>


                            <!-- Key Input -->
                            <TextBlock Text="LİSANS ANAHTARI" FontSize="10" FontWeight="Bold" Foreground="#ADB5BD" Margin="0,0,0,5"/>
                            <TextBox x:Name="TxtLicenseKey" Text="" Tag="ALPNET-XXXX-XXXX-XXXX" Background="#15171E" Foreground="#F8F9FA" BorderBrush="#252833" Padding="8" Margin="0,0,0,15" FontSize="12" FontFamily="Consolas" FontWeight="Bold" TextAlignment="Center"/>

                            <!-- Error Box -->
                            <Border x:Name="LicenseErrorBorder" Background="#26FF0844" BorderBrush="#80FF0844" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,15" Visibility="Collapsed">
                                <TextBlock x:Name="LblLicenseError" Text="Hata oluştu." TextWrapping="Wrap" Foreground="#FF0844" FontSize="11" HorizontalAlignment="Center"/>
                            </Border>

                            <!-- Activate Button -->
                            <Button x:Name="BtnActivate" Content="LİSANSI AKTİFLEŞTİR ➔" Height="40" Background="#00F2FE" Foreground="#0B0C10" FontWeight="Bold" Click="ActivateLicense_Click" Cursor="Hand" Style="{StaticResource FlatButtonStyle}"/>

                            <!-- AlpTogether Ecosystem Cloud Verify -->
                            <Button x:Name="BtnCheckAlpTogether" Content="✦ AlpTogether Yetkisini Doğrula 🔄" Height="36" Background="#26FF2E93" Foreground="#FF5CAA" BorderBrush="#80FF2E93" BorderThickness="1" FontWeight="Bold" Click="CheckAlpTogether_Click" Cursor="Hand" Style="{StaticResource FlatButtonStyle}" Margin="0,8,0,0"/>

                            <!-- New Subscription / Trial Buttons -->
                            <StackPanel Margin="0,20,0,0">
                                <TextBlock Text="VEYA SATIN ALIN / DENEYİN" FontSize="10" FontWeight="Bold" Foreground="#ADB5BD" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                                
                                <Button x:Name="BtnTrial" Content="⚡ 1 Saat Ücretsiz Dene" Height="36" Background="#3300F2FE" Foreground="#00F2FE" FontWeight="Bold" Click="StartTrial_Click" Cursor="Hand" Style="{StaticResource FlatButtonStyle}" Margin="0,0,0,8"/>
                                
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" x:Name="BtnBuyWeekly" Content="🧰’ Haftalık Satın Al" Height="36" Background="#1D2A35" Foreground="#F8F9FA" FontWeight="Bold" Click="BuyWeekly_Click" Cursor="Hand" Style="{StaticResource FlatButtonStyle}"/>
                                    <Button Grid.Column="2" x:Name="BtnBuyMonthly" Content="🧰’ Aylık Satın Al" Height="36" Background="#1D2A35" Foreground="#F8F9FA" FontWeight="Bold" Click="BuyMonthly_Click" Cursor="Hand" Style="{StaticResource FlatButtonStyle}"/>
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- MAIN INTERFACE -->
                <Grid x:Name="MainDashboard" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="260"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left Sidebar (Menu) -->
                    <Border Grid.Column="0" Background="#11131A" BorderBrush="#1F222B" BorderThickness="0,0,1.5,0" WindowChrome.IsHitTestVisibleInChrome="True">
                        <StackPanel Margin="20">
                            <!-- Nav Menu -->
                            <TextBlock Text="MENÜ" FontSize="10" FontWeight="Bold" Foreground="#667EEA" Margin="0,0,0,10"/>
                            
                            <Button x:Name="MenuBtnDashboard" Content="📊 Gösterge Paneli" HorizontalContentAlignment="Left" Padding="15,0,0,0" Height="45" Background="#1D2A35" Foreground="#00F2FE" FontWeight="Bold" BorderBrush="Transparent" Click="Menu_Click" Cursor="Hand" Margin="0,0,0,8" Style="{StaticResource FlatButtonStyle}"/>
                            <Button x:Name="MenuBtnTools" Content="🧰 Ağ Araçları" HorizontalContentAlignment="Left" Padding="15,0,0,0" Height="45" Background="Transparent" Foreground="#ADB5BD" FontWeight="Bold" BorderBrush="Transparent" Click="Menu_Click" Cursor="Hand" Margin="0,0,0,8" Style="{StaticResource FlatButtonStyle}"/>
                            <Button x:Name="MenuBtnWifi" Content="📡 Wi-Fi Analizörü" HorizontalContentAlignment="Left" Padding="15,0,0,0" Height="45" Background="Transparent" Foreground="#ADB5BD" FontWeight="Bold" BorderBrush="Transparent" Click="Menu_Click" Cursor="Hand" Margin="0,0,0,8" Style="{StaticResource FlatButtonStyle}"/>
                            <Button x:Name="MenuBtnGameMode" Content="🎮 Oyun Modu" HorizontalContentAlignment="Left" Padding="15,0,0,0" Height="45" Background="Transparent" Foreground="#ADB5BD" FontWeight="Bold" BorderBrush="Transparent" Click="Menu_Click" Cursor="Hand" Margin="0,0,0,8" Style="{StaticResource FlatButtonStyle}"/>
                            <Button x:Name="MenuBtnReplay" Content="🎬 Oyun Kaydı" HorizontalContentAlignment="Left" Padding="15,0,0,0" Height="45" Background="Transparent" Foreground="#ADB5BD" FontWeight="Bold" BorderBrush="Transparent" Click="Menu_Click" Cursor="Hand" Margin="0,0,0,8" Style="{StaticResource FlatButtonStyle}"/>
                            <Button x:Name="MenuBtnVoiceTranslation" Content="🎤 Sesli Çeviri" HorizontalContentAlignment="Left" Padding="15,0,0,0" Height="45" Background="Transparent" Foreground="#ADB5BD" FontWeight="Bold" BorderBrush="Transparent" Click="Menu_Click" Cursor="Hand" Margin="0,0,0,8" Style="{StaticResource FlatButtonStyle}"/>
                            <Button x:Name="MenuBtnLicense" Content="🔑 Lisans &amp; Hesap" HorizontalContentAlignment="Left" Padding="15,0,0,0" Height="45" Background="Transparent" Foreground="#ADB5BD" FontWeight="Bold" BorderBrush="Transparent" Click="Menu_Click" Cursor="Hand" Margin="0,0,0,8" Style="{StaticResource FlatButtonStyle}"/>
                            
                            <Separator Background="#252833" Margin="0,15,0,20"/>
                            
                            <!-- Small SİSTEM Info -->
                            <TextBlock Text="SİSTEM DURUMU" FontSize="10" FontWeight="Bold" Foreground="#667EEA" Margin="0,0,0,10"/>
                            <TextBlock Text="Dış IP Adresi (WAN)" FontSize="10" Foreground="#ADB5BD" Margin="0,0,0,2"/>
                            <TextBlock x:Name="LblPublicIp" Text="Yükleniyor..." FontSize="12" FontWeight="Bold" Foreground="#F8F9FA" Margin="0,0,0,10"/>
                            <TextBlock Text="Bağlantı Türü" FontSize="10" Foreground="#ADB5BD" Margin="0,0,0,2"/>
                            <TextBlock x:Name="LblConnectionType" Text="Ethernet" FontSize="12" FontWeight="Bold" Foreground="#00FF87" Margin="0,0,0,10"/>
                            <TextBlock Text="Uygulama sürümü" FontSize="10" Foreground="#ADB5BD" Margin="0,0,0,2"/>
                            <TextBlock x:Name="LblAppVersion" Text="v2.2.7" FontSize="12" FontWeight="Bold" Foreground="#F8F9FA" Margin="0,0,0,10"/>
                            <Button x:Name="BtnRestartForUpdate" Content="Yeniden Başlat ve Güncelle" Background="#0088D6" Foreground="White" FontWeight="Bold" FontSize="11" Padding="10,5" BorderThickness="0" Cursor="Hand" Visibility="Collapsed" Click="BtnRestartForUpdate_Click">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="4"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- Right Main panel -->
                    <Grid Grid.Column="1" Margin="20" WindowChrome.IsHitTestVisibleInChrome="True">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Header -->
                        <Grid Grid.Row="0" Margin="0,0,0,20">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="PageTitle" Text="Gösterge Paneli" FontSize="24" FontWeight="ExtraBold" Foreground="#F8F9FA"/>
                                    <Ellipse Fill="#00FF87" Width="10" Height="10" Margin="10,0,0,0" VerticalAlignment="Center">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Style.Triggers>
                                                    <EventTrigger RoutedEvent="Loaded">
                                                        <BeginStoryboard>
                                                            <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.3" To="1" Duration="0:0:1"/>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </EventTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                </StackPanel>
                                <TextBlock x:Name="PageSubtitle" Text="Gelişmiş Ethernet Aktarım Gücü &amp; Sağlık Analizörü" FontSize="12" Foreground="#ADB5BD" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Grid>

                        <!-- Content Scroll Area -->
                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Style="{StaticResource FavScrollViewer}">
                            <StackPanel>
                                <!-- PAGE 1: DASHBOARD -->
                                <StackPanel x:Name="PageDashboard" Visibility="Visible">
                                    
                                    <!-- WiFi Warning Banner (Conditional) -->
                                    <Border x:Name="WifiWarningBanner" Background="#26FF9900" BorderBrush="#80FF9900" BorderThickness="1" CornerRadius="12" Padding="15,10" Margin="0,0,0,20" Visibility="Collapsed">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="⚠️" FontSize="18" Foreground="#FF9900" FontWeight="Bold" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Aktif Bağlantınız Wi-Fi olarak algılandı. Donanım sağlığı için Lütfen Ethernet kablosunu bağlayın." Foreground="#FF9900" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>
                                    
                                    <!-- First Row: 4 Metric Cards -->
                                    <Grid Margin="0,0,0,20">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Card 1: Speed -->
                                        <Border Grid.Column="0" Background="#1E2028" BorderBrush="#1C2F3D" BorderThickness="1" CornerRadius="14" Padding="15" Margin="0,0,8,0">
                                            <StackPanel>
                                                <TextBlock Text="🚀" FontSize="24" Margin="0,0,0,5"/>
                                                <TextBlock Text="Aktarım Gücü" FontSize="11" Foreground="#ADB5BD" FontWeight="Bold"/>
                                                <TextBlock x:Name="CardSpeedVal" Text="---" FontSize="18" FontWeight="Bold" Foreground="#00F2FE" Margin="0,5"/>
                                                <TextBlock Text="Bağdaştırıcı anlık Hızı (Link Speed)" FontSize="9" Foreground="#ADB5BD" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Card 2: Standard -->
                                        <Border Grid.Column="1" Background="#1E2028" BorderBrush="#1C2F3D" BorderThickness="1" CornerRadius="14" Padding="15" Margin="4,0,4,0">
                                            <StackPanel>
                                                <TextBlock Text="📡" FontSize="24" Margin="0,0,0,5"/>
                                                <TextBlock Text="Kablo Standardı" FontSize="11" Foreground="#ADB5BD" FontWeight="Bold"/>
                                                <TextBlock x:Name="CardStandardVal" Text="---" FontSize="18" FontWeight="Bold" Foreground="#667EEA" Margin="0,5" TextWrapping="NoWrap"/>
                                                <TextBlock Text="Hızı göre tahmini donanım standardı" FontSize="9" Foreground="#ADB5BD" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Card 3: Gateway -->
                                        <Border Grid.Column="2" Background="#1E2028" BorderBrush="#1C2F3D" BorderThickness="1" CornerRadius="14" Padding="15" Margin="4,0,4,0">
                                            <StackPanel>
                                                <TextBlock Text="🔗" FontSize="24" Margin="0,0,0,5"/>
                                                <TextBlock Text="Karşı Bağlantı" FontSize="11" Foreground="#ADB5BD" FontWeight="Bold"/>
                                                <TextBlock x:Name="CardGatewayVal" Text="---" FontSize="14" FontWeight="Bold" Foreground="#00FF87" Margin="0,5" TextWrapping="Wrap"/>
                                                <TextBlock Text="Ağ Geçidi IP ve MAC adresi" FontSize="9" Foreground="#ADB5BD" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Card 4: Health -->
                                        <Border Grid.Column="3" Background="#1E2028" BorderBrush="#1C2F3D" BorderThickness="1" CornerRadius="14" Padding="15" Margin="8,0,0,0">
                                            <StackPanel>
                                                            <TextBlock Text="❤️" FontSize="24" Margin="0,0,0,5"/>
