<Window x:Class="AlpNetKeygenUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AlpNet Pulse - Lisans Üretici" Height="680" Width="980"
        WindowStartupLocation="CenterScreen" Icon="alpnet_icon.ico"
        Background="#0B0C10" Foreground="#F8F9FA" FontFamily="Segoe UI"
        WindowStyle="None" AllowsTransparency="True" MouseLeftButtonDown="Window_MouseLeftButtonDown">
    
    <Window.Resources>
        <Style x:Key="FlatButtonStyle" TargetType="Button">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="FlatRadioButtonStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#ADB5BD"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Foreground" Value="#00F2FE"/>
                    <Setter Property="Background" Value="#1D2A35"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="#F8F9FA"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="DarkListViewItem" TargetType="ListViewItem">
            <Setter Property="Background" Value="#15171E"/>
            <Setter Property="Foreground" Value="#F8F9FA"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                            <GridViewRowPresenter Content="{TemplateBinding Content}" Columns="{TemplateBinding GridView.ColumnCollection}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#2E3244"/>
                    <Setter Property="Foreground" Value="#00F2FE"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1D2A35"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border BorderBrush="#1F222B" BorderThickness="1" CornerRadius="16" Background="#0B0C10">
        <Grid>
            <!-- Title Bar -->
            <Grid VerticalAlignment="Top" Height="40" Background="#11131A">
                <StackPanel Orientation="Horizontal" Margin="15,0,0,0">
                    <TextBlock Text="🔑" VerticalAlignment="Center" Foreground="#00F2FE" FontSize="16" Margin="0,0,8,0"/>
                    <TextBlock Text="AlpNet Lisans Üretici (KeyGen)" VerticalAlignment="Center" FontWeight="Bold" Foreground="#F8F9FA"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="—" Width="40" Background="Transparent" Foreground="#F8F9FA" BorderBrush="Transparent" Click="MinimizeButton_Click" FontSize="14" FontWeight="Bold" Cursor="Hand"/>
                    <Button Content="×" Width="40" Background="Transparent" Foreground="#F8F9FA" BorderBrush="Transparent" Click="CloseButton_Click" FontSize="16" FontWeight="Bold" Cursor="Hand"/>
                </StackPanel>
            </Grid>

            <!-- Main Content -->
            <Grid Margin="25,50,25,25">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="20"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Dashboard Stats -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="15"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="15"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <Border Grid.Column="0" Background="#15171E" BorderBrush="#252833" BorderThickness="1" CornerRadius="8" Padding="15">
                        <StackPanel>
                            <TextBlock Text="Toplam Gelir" Foreground="#ADB5BD" FontSize="12"/>
                            <TextBlock x:Name="TxtTotalRevenue" Text="$0.00" Foreground="#00F2FE" FontSize="24" FontWeight="Bold" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>
                    
                    <Border Grid.Column="2" Background="#15171E" BorderBrush="#252833" BorderThickness="1" CornerRadius="8" Padding="15">
                        <StackPanel>
                            <TextBlock Text="Aktif Aboneler" Foreground="#ADB5BD" FontSize="12"/>
                            <TextBlock x:Name="TxtActiveSubs" Text="0" Foreground="#00FF87" FontSize="24" FontWeight="Bold" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>
                    
                    <Border Grid.Column="4" Background="#15171E" BorderBrush="#252833" BorderThickness="1" CornerRadius="8" Padding="15">
                        <StackPanel>
                            <TextBlock Text="Üretilen Lisanslar" Foreground="#ADB5BD" FontSize="12"/>
                            <TextBlock x:Name="TxtTotalLicenses" Text="0" Foreground="#F8F9FA" FontSize="24" FontWeight="Bold" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Generator & History -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="320"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Left Panel: Key Generation -->
                <StackPanel Grid.Column="0">
                    <!-- Note / Customer -->
                    <TextBlock Text="Not / Müşteri Adı (İsteğe Bağlı)" FontSize="12" Foreground="#ADB5BD" Margin="0,0,0,5"/>
                    <TextBox x:Name="TxtNote" Height="36" Background="#15171E" Foreground="#F8F9FA" BorderBrush="#252833" BorderThickness="1" Padding="10,8" Margin="0,0,0,15"/>

                    <!-- Target HWID -->
                    <TextBlock Text="Hedef Donanım Kimliği (HWID)" FontSize="12" Foreground="#ADB5BD" Margin="0,0,0,5"/>
                    <TextBox x:Name="TxtHwid" Height="36" Background="#15171E" Foreground="#F8F9FA" BorderBrush="#252833" BorderThickness="1" Padding="10,8" Margin="0,0,0,15"/>

                    <!-- Duration -->
                    <TextBlock Text="Lisans Süresi" FontSize="12" Foreground="#ADB5BD" Margin="0,0,0,5"/>
                    <ComboBox x:Name="CmbDuration" Height="36" Background="#15171E" Foreground="#F8F9FA" BorderBrush="#252833" BorderThickness="1" Padding="10,0,30,0" Margin="0,0,0,25" SelectedIndex="0">
                        <ComboBox.Style>
                            <Style TargetType="ComboBox">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ComboBox">
                                            <Grid>
                                                <ToggleButton Name="ToggleButton" 
                                                              BorderBrush="{TemplateBinding BorderBrush}" 
                                                              Background="{TemplateBinding Background}" 
                                                              Focusable="false" 
                                                              IsChecked="{Binding Path=IsDropDownOpen,Mode=TwoWay,RelativeSource={RelativeSource TemplatedParent}}" 
                                                              ClickMode="Press">
                                                    <ToggleButton.Template>
                                                        <ControlTemplate TargetType="ToggleButton">
                                                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1">
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="30"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Grid.Column="1" Text="▼" Foreground="#ADB5BD" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                </Grid>
                                                            </Border>
                                                        </ControlTemplate>
                                                    </ToggleButton.Template>
                                                </ToggleButton>
                                                <ContentPresenter Name="ContentSite" IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" Margin="10,0,30,0" VerticalAlignment="Center" HorizontalAlignment="Left" />
                                                <Popup Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                                                    <Grid Name="DropDown" SnapsToDevicePixels="True" MinWidth="{TemplateBinding ActualWidth}" MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                                        <Border x:Name="DropDownBorder" Background="#11131A" BorderThickness="1" BorderBrush="#252833"/>
                                                        <ScrollViewer Margin="1" SnapsToDevicePixels="True">
                                                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
                                                        </ScrollViewer>
                                                    </Grid>
                                                </Popup>
                                            </Grid>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ComboBox.Style>
                        <ComboBox.ItemContainerStyle>
                            <Style TargetType="ComboBoxItem">
                                <Setter Property="Background" Value="#15171E"/>
                                <Setter Property="Foreground" Value="#F8F9FA"/>
                                <Setter Property="Padding" Value="10,6"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ComboBoxItem">
                                            <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#2E3244"/>
                                        <Setter Property="Foreground" Value="#00F2FE"/>
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#1D2A35"/>
                                        <Setter Property="Foreground" Value="#00F2FE"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ComboBox.ItemContainerStyle>
                        <ComboBoxItem Content="1 Saatlik"/>
                        <ComboBoxItem Content="6 Saatlik"/>
                        <ComboBoxItem Content="12 Saatlik"/>
                        <ComboBoxItem Content="Günlük (24 Saat)"/>
                        <ComboBoxItem Content="Haftalık (7 Gün)"/>
                        <ComboBoxItem Content="Aylık (30 Gün)"/>
                        <ComboBoxItem Content="Yıllık (365 Gün)"/>
                        <ComboBoxItem Content="Sınırsız (Ömür Boyu)"/>
                    </ComboBox>

                    <!-- Price -->
                    <TextBlock Text="Fiyat ($)" FontSize="12" Foreground="#ADB5BD" Margin="0,0,0,5"/>
                    <TextBox x:Name="TxtPrice" Height="36" Background="#15171E" Foreground="#00FF87" BorderBrush="#252833" BorderThickness="1" Padding="10,8" Margin="0,0,0,20" Text="0" FontWeight="Bold"/>

                    <!-- Generate Button -->
                    <Button Content="LİSANS ŞİFRESİ ÜRET" Height="45" Background="#667EEA" Foreground="#F8F9FA" FontWeight="Bold" Cursor="Hand" Click="Generate_Click" Style="{StaticResource FlatButtonStyle}" Margin="0,0,0,20"/>

                    <!-- Output Key -->
                    <TextBlock Text="Oluşturulan Lisans Şifresi" FontSize="12" Foreground="#00F2FE" Margin="0,0,0,5"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TxtOutputKey" Height="50" Background="#11131A" Foreground="#00FF87" BorderBrush="#1C2F3D" BorderThickness="1" Padding="10,4" TextWrapping="Wrap" IsReadOnly="True" FontFamily="Consolas"/>
                        <Button Grid.Column="1" Content="KOPYALA" Width="80" Margin="10,0,0,0" Background="#1D2A35" Foreground="#00F2FE" FontWeight="Bold" Cursor="Hand" Click="Copy_Click" Style="{StaticResource FlatButtonStyle}"/>
                    </Grid>
                    
                    <TextBlock x:Name="TxtStatus" Text="Hazır." FontSize="11" Foreground="#ADB5BD" Margin="0,15,0,0" HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- Separator -->
                <Border Grid.Column="1" Width="1" Background="#1F222B" HorizontalAlignment="Center" Margin="0,10"/>

                <!-- Right Panel: History -->
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <Grid Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="TabHistory" Content="📜 Geçmiş" FontSize="14" IsChecked="True" Style="{StaticResource FlatRadioButtonStyle}" Checked="Tab_Checked"/>
                            <RadioButton x:Name="TabBlacklist" Content="🚫 Kara Liste" FontSize="14" Style="{StaticResource FlatRadioButtonStyle}" Checked="Tab_Checked" Margin="10,0,0,0"/>
                            <RadioButton x:Name="TabLiveDevices" Content="📡 Cihazlar" FontSize="14" Style="{StaticResource FlatRadioButtonStyle}" Checked="Tab_Checked" Margin="10,0,0,0"/>
                            <RadioButton x:Name="TabSettings" Content="⚙️ Ayarlar" FontSize="14" Style="{StaticResource FlatRadioButtonStyle}" Checked="Tab_Checked" Margin="10,0,0,0"/>
                        </StackPanel>

                        <Button x:Name="BtnDeleteExpired" Grid.Column="1" Content="🗑️ SÜRESİ DOLANLARI SİL" Background="#E81123" Foreground="#F8F9FA" FontWeight="Bold" Padding="10,0" BorderThickness="0" Cursor="Hand" Click="DeleteExpired_Click" Style="{StaticResource FlatButtonStyle}"/>
                    </Grid>
                    
                    <ListView x:Name="LstHistory" Grid.Row="1" Background="#11131A" BorderBrush="#252833" BorderThickness="1" Foreground="#F8F9FA" ItemContainerStyle="{StaticResource DarkListViewItem}">
                        <ListView.ContextMenu>
                            <ContextMenu Background="#15171E" Foreground="#F8F9FA" BorderBrush="#252833">
                                <MenuItem Header="Kopyala" Click="ContextMenu_HistoryCopy_Click"/>
                                <MenuItem Header="Notu Düzenle" Click="ContextMenu_HistoryRename_Click"/>
                                <MenuItem Header="Sil" Click="ContextMenu_HistoryDelete_Click"/>
                            </ContextMenu>
                        </ListView.ContextMenu>
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Tarih" DisplayMemberBinding="{Binding CreatedAt}" Width="110"/>
                                <GridViewColumn Header="Not / Müşteri" DisplayMemberBinding="{Binding Note}" Width="130"/>
                                <GridViewColumn Header="Süre" DisplayMemberBinding="{Binding Duration}" Width="80"/>
                                <GridViewColumn Header="Fiyat" Width="60">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding FormattedPrice}" Foreground="#00FF87" FontWeight="SemiBold"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="Durum" Width="90">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusColor}" FontWeight="Bold"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="İşlem" Width="130">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <Button Content="Kopyala" Width="60" Height="24" Background="#1D2A35" Foreground="#00F2FE" BorderBrush="Transparent" Cursor="Hand" Click="HistoryCopy_Click" Tag="{Binding}"/>
                                                <Button Content="Sil" Width="40" Height="24" Background="#2A1D20" Foreground="#FF3B30" BorderBrush="Transparent" Cursor="Hand" Click="HistoryDelete_Click" Tag="{Binding}" Margin="5,0,0,0"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ListView>

                    <ListView x:Name="LstBlacklist" Grid.Row="1" Visibility="Collapsed" Background="#11131A" BorderBrush="#252833" BorderThickness="1" Foreground="#F8F9FA" ItemContainerStyle="{StaticResource DarkListViewItem}">
                        <ListView.ContextMenu>
                            <ContextMenu Background="#15171E" Foreground="#F8F9FA" BorderBrush="#252833">
                                <MenuItem Header="Kaldır" Click="ContextMenu_BlacklistRemove_Click"/>
                            </ContextMenu>
                        </ListView.ContextMenu>
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Tarih" DisplayMemberBinding="{Binding CreatedAt}" Width="110"/>
                                <GridViewColumn Header="Not / Müşteri" DisplayMemberBinding="{Binding Note}" Width="130"/>
                                <GridViewColumn Header="Süre" DisplayMemberBinding="{Binding Duration}" Width="80"/>
                                <GridViewColumn Header="Durum" Width="170">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusColor}" FontWeight="Bold"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="İşlem" Width="80">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="Kaldır" Width="60" Height="24" Background="#1D2A35" Foreground="#00F2FE" BorderBrush="Transparent" Cursor="Hand" Click="BlacklistRemove_Click" Tag="{Binding}"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ListView>

                    <Grid x:Name="PanelLiveDevices" Grid.Row="1" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        
                        <ListView x:Name="LstLiveDevices" Background="#11131A" BorderBrush="#252833" BorderThickness="1" Foreground="#F8F9FA" ItemContainerStyle="{StaticResource DarkListViewItem}">
                            <ListView.ContextMenu>
                                <ContextMenu Background="#15171E" Foreground="#F8F9FA" BorderBrush="#252833">
                                    <MenuItem Header="HWID Kopyala" Click="ContextMenu_LiveCopyHwid_Click"/>
                                    <MenuItem Header="Yasakla" Click="ContextMenu_LiveBan_Click"/>
                                </ContextMenu>
                            </ListView.ContextMenu>
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="HWID" DisplayMemberBinding="{Binding Hwid}" Width="110"/>
                                    <GridViewColumn Header="Lisans" DisplayMemberBinding="{Binding LicenseKey}" Width="90"/>
                                    <GridViewColumn Header="Sürüm" DisplayMemberBinding="{Binding Version}" Width="60"/>
                                    <GridViewColumn Header="Not" DisplayMemberBinding="{Binding Note}" Width="100"/>
                                    <GridViewColumn Header="Süre" DisplayMemberBinding="{Binding Duration}" Width="80"/>
                                    <GridViewColumn Header="Son Görülme" DisplayMemberBinding="{Binding LastSeenText}" Width="100"/>
                                    <GridViewColumn Header="Durum" Width="70">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Status}" Foreground="{Binding StatusColor}" FontWeight="Bold"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="İşlem" Width="130">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <Button Content="HWID" Width="50" Height="24" Background="#1D2A35" Foreground="#00F2FE" BorderBrush="Transparent" Cursor="Hand" Click="LiveCopyHwid_Click" Tag="{Binding}" ToolTip="HWID Kopyala"/>
                                                    <Button Content="Yasakla" Width="60" Height="24" Background="#2A1D20" Foreground="#FF3B30" BorderBrush="Transparent" Cursor="Hand" Click="LiveBan_Click" Tag="{Binding}" Margin="5,0,0,0"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                </GridView>
                            </ListView.View>
                        </ListView>

                        <Border Grid.Row="1" Background="#11131A" BorderBrush="#252833" BorderThickness="1" Margin="0,10,0,0" Padding="10">
                            <StackPanel>
                                <TextBlock Text="Özel Mesaj Gönder (Listeden bir cihaz seçin)" Foreground="#ADB5BD" FontSize="12" Margin="0,0,0,5"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="TxtDirectMsg" Height="30" Background="#15171E" Foreground="#F8F9FA" BorderBrush="#252833" BorderThickness="1" Padding="5,4" VerticalContentAlignment="Center"/>
                                    <Button Grid.Column="1" Content="GÖNDER" Width="80" Margin="10,0,0,0" Background="#667EEA" Foreground="#F8F9FA" FontWeight="Bold" Cursor="Hand" Click="SendDirectMsg_Click" Style="{StaticResource FlatButtonStyle}"/>
                                </Grid>
                                <TextBlock x:Name="TxtDirectMsgStatus" Foreground="#00F2FE" FontSize="12" Margin="0,5,0,0" HorizontalAlignment="Right" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Settings Panel -->
                    <ScrollViewer x:Name="PanelSettings" Grid.Row="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,10,20,10">
                            <!-- Maintenance Mode -->
                            <TextBlock Text="🔒 Bakım Modu (Kill Switch)" FontSize="16" Foreground="#00F2FE" FontWeight="Bold" Margin="0,0,0,10"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <CheckBox x:Name="ChkMaintenance" Content="Bakım Modunu Aktifleştir" Foreground="#F8F9FA" FontSize="14" Margin="0,0,20,0"/>
                                <Button Content="KAYDET" Width="100" Height="25" Background="#667EEA" Foreground="#F8F9FA" FontWeight="Bold" Cursor="Hand" Style="{StaticResource FlatButtonStyle}" Click="SaveMaintenance_Click"/>
                            </StackPanel>
                            <TextBlock Text="Bakım Mesajı:" FontSize="12" Foreground="#ADB5BD" Margin="0,0,0,5"/>
                            <TextBox x:Name="TxtMaintenanceMsg" Height="60" Background="#11131A" Foreground="#F8F9FA" BorderBrush="#252833" BorderThickness="1" Padding="10" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,0,0,20"/>
                            
                            <!-- Broadcast System -->
                            <TextBlock Text="📢 Canlı Duyuru Sistemi" FontSize="16" Foreground="#00F2FE" FontWeight="Bold" Margin="0,0,0,10"/>
                            <TextBlock Text="Duyuru Mesajı:" FontSize="12" Foreground="#ADB5BD" Margin="0,0,0,5"/>
                            <TextBox x:Name="TxtBroadcastMsg" Height="60" Background="#11131A" Foreground="#F8F9FA" BorderBrush="#252833" BorderThickness="1" Padding="10" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,0,0,10"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                                <Button Content="DUYURUYU YAYINLA" Width="150" Height="30" Background="#667EEA" Foreground="#F8F9FA" FontWeight="Bold" Cursor="Hand" Style="{StaticResource FlatButtonStyle}" Click="SaveBroadcast_Click" Margin="0,0,10,0"/>
                                <Button Content="DUYURUYU TEMİZLE" Width="150" Height="30" Background="#2A1D20" Foreground="#FF3B30" FontWeight="Bold" Cursor="Hand" Style="{StaticResource FlatButtonStyle}" Click="ClearBroadcast_Click"/>
                            </StackPanel>

                            <!-- Auto Update -->
                            <TextBlock Text="🔄 Otomatik Güncelleme" FontSize="16" Foreground="#00F2FE" FontWeight="Bold" Margin="0,0,0,10"/>
                            <TextBlock Text="Güncel Versiyon (Örn: 1.0.1):" FontSize="12" Foreground="#ADB5BD" Margin="0,0,0,5"/>
                            <TextBox x:Name="TxtVersion" Height="36" Background="#11131A" Foreground="#00FF87" BorderBrush="#252833" BorderThickness="1" Padding="10,8" Margin="0,0,0,10"/>
                            <TextBlock Text="İndirme Linki (Update URL):" FontSize="12" Foreground="#ADB5BD" Margin="0,0,0,5"/>
                            <TextBox x:Name="TxtUpdateUrl" Height="36" Background="#11131A" Foreground="#F8F9FA" BorderBrush="#252833" BorderThickness="1" Padding="10,8" Margin="0,0,0,20"/>

                            <!-- Update Button -->
                            <Button Content="SÜRÜMÜ YAYINLA" Height="45" Background="#00FF87" Foreground="#13151A" FontWeight="Bold" Cursor="Hand" Click="SaveUpdate_Click" Style="{StaticResource FlatButtonStyle}"/>
                            <TextBlock x:Name="TxtSettingsStatus" Text="" FontSize="12" Foreground="#00FF87" Margin="0,10,0,0" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </ScrollViewer>

                </Grid>
            </Grid>
            </Grid>
            
            <!-- Ban Overlay -->
            <Grid x:Name="BanOverlay" Visibility="Collapsed" Background="#B2000000" Panel.ZIndex="100">
                <Border Width="450" Height="220" Background="#11131A" BorderBrush="#252833" BorderThickness="1" CornerRadius="12" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="20">
                    <StackPanel>
                        <TextBlock Text="🚫 Yasaklama Seçeneği" Foreground="#FF3B30" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                        <TextBlock Text="Bu lisansı silmek istiyorsunuz. Lütfen eylemi seçin:" Foreground="#ADB5BD" FontSize="14" TextWrapping="Wrap" HorizontalAlignment="Center" Margin="0,0,0,25"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button Content="Sadece Anahtarı İptal Et" Width="180" Height="40" Background="#1D2A35" Foreground="#00F2FE" FontWeight="Bold" Cursor="Hand" Style="{StaticResource FlatButtonStyle}" Click="BanOverlay_Key_Click"/>
                            <Button Content="Cihazı Komple Yasakla" Width="180" Height="40" Background="#2A1D20" Foreground="#FF3B30" FontWeight="Bold" Cursor="Hand" Style="{StaticResource FlatButtonStyle}" Click="BanOverlay_HWID_Click" Margin="10,0,0,0"/>
                        </StackPanel>
                        <Button Content="İPTAL" Width="100" Height="30" Background="Transparent" Foreground="#ADB5BD" FontWeight="Bold" Cursor="Hand" Click="BanOverlay_Cancel_Click" Margin="0,20,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
            <Grid x:Name="RenameOverlay" Visibility="Collapsed" Background="#B2000000" Panel.ZIndex="100">
                <Border Width="450" Height="220" Background="#11131A" BorderBrush="#252833" BorderThickness="1" CornerRadius="12" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="20">
                    <StackPanel>
                        <TextBlock Text="✏️ Notu Düzenle" Foreground="#00F2FE" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                        <TextBlock Text="Bu lisans için yeni bir not/isim belirleyin:" Foreground="#ADB5BD" FontSize="14" TextWrapping="Wrap" HorizontalAlignment="Center" Margin="0,0,0,15"/>
                        <TextBox x:Name="TxtRenameInput" Width="300" Height="30" Background="#1D2A35" Foreground="#F8F9FA" BorderBrush="#252833" BorderThickness="1" Padding="5" VerticalContentAlignment="Center" Margin="0,0,0,20"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button Content="KAYDET" Width="120" Height="40" Background="#1D2A35" Foreground="#00F2FE" FontWeight="Bold" Cursor="Hand" Style="{StaticResource FlatButtonStyle}" Click="RenameOverlay_Save_Click"/>
                            <Button Content="İPTAL" Width="120" Height="40" Background="Transparent" Foreground="#ADB5BD" FontWeight="Bold" Cursor="Hand" Click="RenameOverlay_Cancel_Click" Margin="10,0,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
